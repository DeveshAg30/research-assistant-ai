PORT=5000
MONGODB_URI=mongodb://localhost:27017/research_assistant

# Where the FastAPI AI microservice is running
AI_SERVICE_URL=http://localhost:8000
# Must match AI_SERVICE_TOKEN in ai-service/.env
AI_SERVICE_TOKEN=
# Keep above the agent's AGENT_TIMEOUT_S (110s) and below the client's 130s.
AI_SERVICE_TIMEOUT_MS=120000

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Where the Vite React client is running (for CORS); comma-separate several.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when behind a reverse proxy (Render, nginx) so rate limits see real IPs.
TRUST_PROXY=

# Rate limits and quotas
GLOBAL_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
QUERY_RATE_LIMIT=10
DAILY_QUERY_LIMIT=50
DAILY_GLOBAL_QUERY_LIMIT=2000

# Follow-up context: completed turns of the thread sent to the agent
HISTORY_TURNS=6

# Bearer token required for GET /metrics in production
METRICS_TOKEN=
LOG_LEVEL=info

NODE_ENV=development

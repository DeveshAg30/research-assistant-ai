# Required: Gemini API key (used for the LLM)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional but recommended: Tavily web search. If unset, falls back to DuckDuckGo
# via the `ddgs` package (no key needed; shorter, lower-quality snippets).
TAVILY_API_KEY=

# Shared secret: the Express server must send it as X-Internal-Token.
# Set the same value as AI_SERVICE_TOKEN in server/.env. Empty = no check (dev only).
AI_SERVICE_TOKEN=

# --- Index (see ingest.py; `python ingest.py --help`) ---
# Rows of the FACTors dataset to index, stratified across organisations.
# 0 = all 118k rows. Changing this triggers a rebuild on next startup.
MAX_INGEST_ROWS=20000
INGEST_SEED=42
# Where the Chroma index is persisted. Mount a persistent disk here in production.
CHROMA_PERSIST_DIR=./chroma_factors_db

# --- Retrieval ---
# Cross-encoder reranker ("none" disables it and falls back to dense similarity).
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_MIN_SCORE=0.2
# Torch device for embeddings + reranker ("cpu", "cuda", "mps"). CPU is the
# safe default; Apple MPS has crashed under concurrent tool calls.
MODEL_DEVICE=cpu
DENSE_MIN_SCORE=0.35
RETRIEVAL_TOP_K=5

# --- Agent limits (cost / latency controls) ---
# Must stay below the server's AI_SERVICE_TIMEOUT_MS.
AGENT_TIMEOUT_S=110
AGENT_MAX_ITERATIONS=8
MAX_WEB_SEARCHES_PER_RUN=3
CLAIM_DECOMPOSITION=on
MAX_CLAIMS=4

# Optional: LangSmith tracing (no code changes needed)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Optional: User-Agent sent to Wikipedia (Wikimedia rejects the library default).
# Ideally include a contact URL or email per https://w.wiki/4wJS
WIKIPEDIA_USER_AGENT=research-assistant-mern/1.0 (https://github.com/; fact-checking app)

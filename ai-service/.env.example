# Required: Gemini API key (used for the LLM)
GOOGLE_API_KEY=

# Optional: Tavily web search. If unset, falls back to DuckDuckGo (no key needed).
TAVILY_API_KEY=

# Comma-separated origins allowed to call this service (the Express server).
ALLOWED_ORIGINS=http://localhost:5000

# Rows of the FACTors dataset to index on first startup (full set is 118k+).
MAX_INGEST_ROWS=2000

# Where the Chroma index is persisted. Mount a persistent disk here in production.
CHROMA_PERSIST_DIR=./chroma_factors_db

# Optional: User-Agent sent to Wikipedia (Wikimedia rejects the library default).
# Ideally include a contact URL or email per https://w.wiki/4wJS
WIKIPEDIA_USER_AGENT=research-assistant-mern/1.0 (https://github.com/; fact-checking app)
